# Application configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# MongoDB connection string (must use a replica set for transactions)
MONGO_URI=mongodb://localhost:27017/payment_processor?replicaSet=rs0

# Redis connection string
REDIS_URL=redis://localhost:6379

# Security: HMAC-SHA256 secret shared with the payment provider
WEBHOOK_SECRET=change-me

# Security: How many seconds around the current time a webhook timestamp is accepted
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
